DOTNET_ENVIRONMENT=Production
Platform__Provider=slack

Slack__AppToken=
Slack__BotToken=
Slack__BotUserId=

# Optional when Platform__Provider=telegram
Telegram__BotToken=
Voice__OpenAiApiKey=

ElRucio__AllowedChatIds__0=<telegram id/>
# System service default (recommended for server installs)
ElRucio__DataDir=/var/lib/elrucio/data
# User service alternative example:
# ElRucio__DataDir=/home/<user>/.local/state/elrucio/data

Memory__Mode=Full
Scheduler__Enabled=true
Scheduler__PollSeconds=60
Voice__Enabled=true
Voice__SttProvider=openai

Video__Enabled=true
Video__Provider=openai
Video__ApiKey=
Video__AnalysisModel=gpt-4o-mini
Video__FfmpegPath=ffmpeg
Video__FrameSampleCount=4
