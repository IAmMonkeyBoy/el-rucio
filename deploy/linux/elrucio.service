[Unit]
Description=El Rucio Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elrucio
Group=elrucio
WorkingDirectory=/opt/elrucio
ExecStart=/usr/bin/dotnet /opt/elrucio/ElRucio.Host.dll
EnvironmentFile=/etc/elrucio/elrucio.env
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=elrucio
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/elrucio
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
