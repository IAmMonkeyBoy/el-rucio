{
  "ElRucio": {
    "DataDir": "data",
    "WorkspaceRoots": [
      "."
    ],
    "RiskLevel": "Conservative",
    "InstructionFileName": "COPILOT.md",
    "AllowedChatIds": [],
    "OwnerBinding": false,
    "MaxResponseChars": 4096
  },
  "Telegram": {
    "BotToken": "",
    "Mode": "Polling",
    "WebhookPublicUrl": ""
  },
  "Copilot": {
    "Model": "gpt-5"
  },
  "Memory": {
    "Mode": "Full",
    "SimpleTurnCount": 12,
    "FtsTopK": 3,
    "RecencyCount": 5,
    "SalienceStart": 1.0,
    "SalienceAccessIncrement": 0.1,
    "SalienceMax": 5.0,
    "SalienceDailyDecayRate": 0.98,
    "SalienceDeleteThreshold": 0.1
  },
  "Scheduler": {
    "Enabled": true,
    "PollSeconds": 60
  },
  "Voice": {
    "Enabled": true,
    "SttProvider": "openai",
    "OpenAiApiKey": "",
    "ForceVoiceReply": false
  },
  "Video": {
    "Enabled": true,
    "Provider": "openai",
    "ApiKey": "",
    "AnalysisModel": "gpt-4o-mini",
    "FfmpegPath": "ffmpeg",
    "FrameSampleCount": 4
  },
  "ServiceInstall": {
    "Enabled": true,
    "GenerateOnly": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
